# Kudosity API credentials — find these in your account under SETTINGS → API Settings.
# Sign up for a trial at https://kudosity.com/trial
KUDOSITY_API_KEY=your_api_key_here

# Default SMS / MMS sender — a number or alphanumeric sender ID registered to your account.
KUDOSITY_SENDER=YourSender

# WhatsApp sender — your registered WhatsApp Business number in E.164 format (e.g. 14155238886).
KUDOSITY_WHATSAPP_SENDER=14155238886

# RCS agent ID — RCS is sent through a registered agent, NOT a phone number (e.g. DemoSender).
KUDOSITY_RCS_AGENT_ID=DemoSender

# Optional: an image for the rich card in ai-delivery-update-rcs. A public https URL that doesn't
# redirect. Leave it unset to send the card without an image.
# DELIVERY_IMAGE_URL=https://your-domain.example/images/delivery.jpg
